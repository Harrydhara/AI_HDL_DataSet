# 1. Read SystemVerilog files first (if they contain shared packages/logic)
read_verilog -sv synchronizer.sv reclocking.sv rising_edge_detector.sv falling_edge_detector.sv spi_reg.sv

# 2. Read standard Verilog files
read_verilog alu.v core.v counter.v decode.v latch_reg.v register.v cpu.v mem_ctrl.v peripheral.v qspi_ctrl.v qspi_flash.v tinyqv.v tt_wrapper.v

# 3. Check hierarchy
# Replacing 'tinyqv' with your top-level module name
synth -top tt_um_tqv_peripheral_harness

stat
clean
# optional 7. Output the result
#write_verilog synthesized_output.v
