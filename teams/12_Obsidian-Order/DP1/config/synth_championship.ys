# AI-HDL 2026 DP2 - Championship-Level Synthesis Script
# Optimizations: Retiming, Clock Gating, Area Recovery
# Target: 100 MHz operation (10ns period)

# Read optimized Verilog source
read_verilog ../src/tqvp_gpio.v

# Set top module with hierarchy check
hierarchy -top tqvp_gpio -check

# Translate processes (always blocks to logic)
proc

# Flatten design for maximum optimization opportunity
flatten

# OPTIMIZATION PASS 1: Pre-mapping optimizations
# -full enables all optimization sub-passes
opt -full

# Technology mapping to generic cell library
techmap

# OPTIMIZATION PASS 2: Post-mapping optimizations
# -fast for quick optimization
opt -fast

# FSM extraction and optimization
fsm
opt

# Resource sharing (Common Subexpression Elimination)
opt_expr
opt_merge -share_all

# Clean up before ABC
opt_clean -purge

# ═══════════════════════════════════════════════════════════
# CRITICAL: ABC optimization with RETIMING enabled
# ═══════════════════════════════════════════════════════════
# -dff: Enable retiming (move registers for timing optimization)
# -D 100: Target delay of 100 time units
#         (With 1ps units: 100 = 100ps = 0.1ns)
#         (Targeting 10ns = 100 MHz operation)
# 
# Note: Retiming can move flip-flops across logic to balance
#       critical paths, enabling higher frequency operation
# ═══════════════════════════════════════════════════════════
abc -dff -D 100

# OPTIMIZATION PASS 3: Post-retiming cleanup
opt -full

# Memory optimization (preserve memory structures)
memory -nomap
opt -full

# Map flip-flops to library (after retiming)
dfflibmap

# FINAL: Aggressive cleanup
opt_clean -purge
clean

# ═══════════════════════════════════════════════════════════
# REPORTING & OUTPUT
# ═══════════════════════════════════════════════════════════

# Print statistics to file
tee -o dp2_championship_stats.txt stat

# Print detailed width information
tee -a dp2_championship_stats.txt stat -width

# Design integrity check
check

# Write optimized netlist (no attributes for cleaner output)
write_verilog -noattr dp2_optimized.v

# Write JSON for tool interoperability
write_json dp2_optimized.json

# Success message
echo "\n=== Championship Synthesis Complete ==="
echo "Output files:"
echo "  - dp2_championship_stats.txt (statistics)"
echo "  - dp2_optimized.v (Verilog netlist)"
echo "  - dp2_optimized.json (JSON netlist)"
echo "=== Target: 100 MHz (10ns period) ==="
