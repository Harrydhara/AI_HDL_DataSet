{
    "DESIGN_NAME": "tt_um_tt_tinyQV",
    "VERILOG_FILES": [
        "dir::../src/project.v",
        "dir::../src/tinyqv.v",
        "dir::../src/cpu.v",
        "dir::../src/core.v",
        "dir::../src/decode.v",
        "dir::../src/alu.v",
        "dir::../src/register.v",
        "dir::../src/counter.v",
        "dir::../src/mem_ctrl.v",
        "dir::../src/qspi_ctrl.v",
        "dir::../src/peripherals.v",
        "dir::../src/tqvp_dma.v",
        "dir::../src/time.v",
        "dir::../src/uart_tx.v"
    ],
    "DIE_AREA": "0 0 432 432",

    "PL_TARGET_DENSITY_PCT": 60,

    "//": "CLOCK_PERIOD 50MHz",
    "CLOCK_PORT": "clk",
    "CLOCK_PERIOD": 20,

    "//": "Hold slack margin",
    "PL_RESIZER_HOLD_SLACK_MARGIN": 0.15,
    "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.1,

    "//": "Setup slack margin",
    "PL_RESIZER_SETUP_SLACK_MARGIN": 0.17,
    "GRT_RESIZER_SETUP_SLACK_MARGIN": 0.12,

    "//": "RUN_LINTER, LINTER_INCLUDE_PDK_MODELS",
    "RUN_LINTER": 1,
    "LINTER_INCLUDE_PDK_MODELS": 1,

    "//": "Synth strategy",
    "SYNTH_STRATEGY": "AREA 1",

    "//": "Clock gating",
    "USE_LIGHTER": 0,

    "//": "SDC Customizations",
    "FALLBACK_SDC_FILE": "dir::tt_um_tt_tinyQV.sdc",

    "//": "Routing tweaks",
    "DESIGN_REPAIR_MAX_SLEW_PCT": 60,
    "DESIGN_REPAIR_MAX_CAP_PCT": 60,
    "RUN_HEURISTIC_DIODE_INSERTION": 1,
    "RUN_ANTENNA_REPAIR": 1,
    "DESIGN_REPAIR_MAX_WIRE_LENGTH": 800,
    "PL_WIRE_LENGTH_COEF": 0.05,
    "HEURISTIC_ANTENNA_THRESHOLD": 100,
    "GRT_ANTENNA_ITERS": 15,
    "GRT_ANTENNA_MARGIN": 20,

    "MAX_TRANSITION_CONSTRAINT": 1.5,
    "RUN_POST_GRT_DESIGN_REPAIR": true,

    "//": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",
    "//": "!!! DO NOT CHANGE ANYTHING BELOW THIS POINT !!!",
    "//": "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!",

    "//": "Save some time",
    "RUN_KLAYOUT_XOR": 0,
    "RUN_KLAYOUT_DRC": 0,

    "//": "Don't put clock buffers on the outputs",
    "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,

    "//": "Reduce wasted space",
    "TOP_MARGIN_MULT": 1,
    "BOTTOM_MARGIN_MULT": 1,
    "LEFT_MARGIN_MULT": 6,
    "RIGHT_MARGIN_MULT": 6,

    "//": "Absolute die size",
    "FP_SIZING": "absolute",

    "GRT_ALLOW_CONGESTION": 1,

    "FP_IO_HLENGTH": 2,
    "FP_IO_VLENGTH": 2,

    "FP_PDN_VPITCH": 38.87,

    "//": "Clock",
    "RUN_CTS": 1,

    "//": "Don't use power rings or met5 layer",
    "FP_PDN_MULTILAYER": 0,
    "RT_MAX_LAYER": "met4",

    "//": "MAGIC_DEF_LABELS may cause issues with LVS",
    "MAGIC_DEF_LABELS": 0,

    "//": "Only export pin area in LEF (without any connected nets)",
    "MAGIC_WRITE_LEF_PINONLY": 1
}